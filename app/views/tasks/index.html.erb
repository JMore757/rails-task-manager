
<div class="min-h-screen bg-gray-50 py-12 px-4">
  <div class="max-w-3xl mx-auto">

    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">My Tasks</h1>
        <p class="mt-2 text-gray-500">Keep track of everything you need to do.</p>
      </div>

      <%= link_to "＋ Add Task", new_task_path,
          class: "inline-flex items-center rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition" %>
    </div>

    <!-- Task List -->
    <div class="space-y-3">

      <% @tasks.each do |task| %>

        <div class="flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md transition">

          <div class="flex items-center gap-3 min-w-0">

            <input
              type="checkbox"
              <%= 'checked="checked"' if task.completed %>
              disabled
              class="h-5 w-5 rounded border-gray-300 text-indigo-600"
            >

            <div class="min-w-0">
              <h3 class="font-semibold text-gray-900 truncate">
                <%= link_to task.title, task_path(task),
                    class: "hover:text-indigo-600 transition" %>
              </h3>

              <p class="text-sm text-gray-500">
                <%= task.completed ? "Completed" : "In progress" %>
              </p>
            </div>

          </div>

          <div class="flex items-center gap-2 shrink-0">

            <%= link_to "Edit", edit_task_path(task),
                class: "rounded-lg bg-amber-100 px-3 py-2 text-sm font-medium text-amber-700 hover:bg-amber-200 transition" %>

            <%= link_to "Delete", task_path(task),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "rounded-lg bg-red-100 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-200 transition" %>

          </div>

        </div>

      <% end %>

      <% if @tasks.empty? %>
        <div class="rounded-xl border-2 border-dashed border-gray-300 bg-white p-12 text-center">
          <h3 class="text-lg font-semibold text-gray-900">No tasks yet</h3>
          <p class="mt-2 text-gray-500">Create your first task to get started!</p>
        </div>
      <% end %>

    </div>

  </div>
</div>
```
